{
  "id": "./",
  "name": "LoveCount",
  "short_name": "LoveCount",
  "description": "Never miss the important moments of the one you care for most.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#FAF7FF",
  "theme_color": "#F43F7A",
  "categories": [
    "lifestyle",
    "social"
  ],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/android-icon-foreground.png",
      "sizes": "432x432",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
